# XAI_API_KEY: Required for xAI Grok API calls used by the AI Mentor.
# Copy this file to .env and set your key from https://console.x.ai/
XAI_API_KEY="MY_XAI_API_KEY"

# Optional override for the Grok model id (default: grok-4.6).
# XAI_MODEL="grok-4.6"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
