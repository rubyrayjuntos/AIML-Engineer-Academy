# XAI_API_KEY: Required for xAI Grok API calls used by the AI Mentor.
# Copy this file to .env and set your key from https://console.x.ai/
XAI_API_KEY="MY_XAI_API_KEY"

# Optional override for the Grok model id (default: grok-4.6).
# XAI_MODEL="grok-4.6"

# Optional: max AI Mentor requests per IP per minute (default 20). Invalid values fall back to 20.
# CHAT_RATE_LIMIT_MAX=20

# Set TRUST_PROXY=1 only when this process sits behind a reverse proxy that
# strips/overwrites X-Forwarded-For. Default ignores that header so clients
# cannot spoof the chat rate-limit key.
# TRUST_PROXY=1

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
