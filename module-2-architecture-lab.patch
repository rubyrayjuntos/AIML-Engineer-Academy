@@ -0,0 +1,79 @@
+import numpy as np
+import pytest
+
+from app.evidence import build_evidence
+from app.mechanics import adapter_parameter_count, cache_comparison, causal_attention, grpo_advantages, kv_cache_bytes, low_rank_adapter, moe_route, symmetric_quantize_4bit
+
+
+def test_attention_is_causal():
+    q = np.eye(3)
+    _, weights = causal_attention(q, q, q)
+    assert np.all(weights[np.triu_indices(3, 1)] == 0)
+
+
+def test_attention_rows_are_probabilities():
+    q = np.eye(3)
+    output, weights = causal_attention(q, q, q)
+    assert output.shape == (3, 3)
+    np.testing.assert_allclose(weights.sum(axis=1), 1)
+
+
+def test_attention_rejects_bad_shapes():
+    with pytest.raises(ValueError):
+        causal_attention(np.ones((2, 2)), np.ones((3, 2)), np.ones((3, 2)))
+
+
+def test_kv_cache_formula():
+    assert kv_cache_bytes(2, 10, 4, 8, 2) == 2560
+
+
+def test_cache_ordering():
+    result = cache_comparison(32, 2048, 32, 8, 128, 512, 64)
+    assert result["simplified_mla"] < result["gqa"] < result["mha"]
+
+
+def test_adapter_shapes_and_zero_initial_delta():
+    a, b = low_rank_adapter(8, 6, 2)
+    assert a.shape == (2, 8) and b.shape == (6, 2)
+    assert np.count_nonzero(b @ a) == 0
+
+
+def test_adapter_is_deterministic():
+    a1, _ = low_rank_adapter(8, 6, 2, seed=7)
+    a2, _ = low_rank_adapter(8, 6, 2, seed=7)
+    np.testing.assert_array_equal(a1, a2)
+
+
+def test_adapter_reduces_parameters():
+    counts = adapter_parameter_count(4096, 4096, 16)
+    assert counts["adapter"] < counts["dense"] and counts["fraction"] < 0.01
+
+
+def test_quantized_values_fit_signed_int4_baseline():
+    result = symmetric_quantize_4bit(np.linspace(-2, 2, 101))
+    assert result.values.min() >= -7 and result.values.max() <= 7
+
+
+def test_quantization_error_is_bounded_by_half_step():
+    values = np.linspace(-1, 1, 24)
+    result = symmetric_quantize_4bit(values)
+    assert np.max(np.abs(values - result.dequantize())) <= result.scale / 2 + 1e-12
+
+
+def test_grpo_is_group_normalized():
+    result = grpo_advantages(np.array([[1, 0, 0, 1], [1, 2, 3, 4]], dtype=float))
+    np.testing.assert_allclose(result.mean(axis=1), 0, atol=1e-8)
+    np.testing.assert_allclose(result.std(axis=1), 1, atol=1e-7)
+
+
+def test_moe_respects_capacity_and_counts_drops():
+    result = moe_route(np.array([[9, 2], [8, 1], [7, 0], [5, 6]], dtype=float), 1, 0.5)
+    assert np.all(result["loads"] <= result["capacity"])
+    assert result["dropped"] == 2
+
+
+def test_evidence_is_deterministic_and_honest():
+    first, second = build_evidence(), build_evidence()
+    assert first == second
+    assert len(first["content_sha256"]) == 64
+    assert first["scope"]["gpu_qlora"].startswith("optional")
