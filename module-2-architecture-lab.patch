+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import numpy as np
+
+from app.mechanics import adapter_parameter_count, cache_comparison, causal_attention, grpo_advantages, moe_route, symmetric_quantize_4bit
+
+
+def build_evidence() -> dict[str, object]:
+    q = np.array([[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]])
+    _, weights = causal_attention(q, q, q)
+    cache = cache_comparison(32, 2048, 32, 8, 128, 512, 64)
+    matrix = np.linspace(-1.0, 1.0, 24).reshape(4, 6)
+    quantized = symmetric_quantize_4bit(matrix)
+    reconstructed = quantized.dequantize()
+    advantages = grpo_advantages(np.array([[1.0, 0.0, 0.0, 1.0]]))
+    routing = moe_route(np.array([[9, 2, 1], [8, 3, 2], [7, 6, 1], [1, 8, 7]], dtype=float), 2)
+    payload = {
+        "schema_version": 1,
+        "runtime": "cpu_numpy",
+        "attention": {"causal_future_mass": float(np.triu(weights, 1).sum()), "row_sums": weights.sum(axis=1).round(12).tolist()},
+        "kv_cache_bytes": cache,
+        "adapter": adapter_parameter_count(4096, 4096, 16),
+        "quantization": {"scheme": "symmetric_signed_int4_baseline", "scale": quantized.scale, "max_abs_error": float(np.max(np.abs(matrix - reconstructed)))},
+        "grpo": {"advantages": advantages.round(8).tolist(), "group_means": advantages.mean(axis=1).round(8).tolist()},
+        "moe": {"capacity": routing["capacity"], "loads": routing["loads"].tolist(), "dropped": routing["dropped"], "imbalance": routing["imbalance"]},
+        "scope": {"verified": "mechanics only", "gpu_qlora": "optional; not claimed by this evidence"},
+    }
+    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    payload["content_sha256"] = hashlib.sha256(canonical.encode()).hexdigest()
+    return payload
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, default=Path("artifacts/evidence.json"))
+    args = parser.parse_args()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(build_evidence(), indent=2, sort_keys=True) + "\n")
+    print(args.output)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/labs/module-2-architecture/app/mechanics.py b/labs/module-2-architecture/app/mechanics.py
