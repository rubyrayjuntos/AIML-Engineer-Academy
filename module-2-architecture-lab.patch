index 0000000..4709a49
--- /dev/null
+++ b/labs/module-2-architecture/app/mechanics.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import math
+import numpy as np
+
+
+def causal_attention(q: np.ndarray, k: np.ndarray, v: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    if q.ndim != 2 or q.shape != k.shape or k.shape[0] != v.shape[0]:
+        raise ValueError("q and k must share [tokens, head_dim]; v must share tokens")
+    scores = q @ k.T / math.sqrt(q.shape[-1])
+    scores[np.triu_indices(scores.shape[0], k=1)] = -np.inf
+    shifted = scores - np.max(scores, axis=-1, keepdims=True)
+    weights = np.exp(shifted)
+    weights /= weights.sum(axis=-1, keepdims=True)
+    return weights @ v, weights
+
+
+def kv_cache_bytes(layers: int, tokens: int, kv_heads: int, head_dim: int, bytes_per_value: int = 2) -> int:
+    if min(layers, tokens, kv_heads, head_dim, bytes_per_value) <= 0:
+        raise ValueError("cache dimensions must be positive")
+    return layers * tokens * kv_heads * head_dim * 2 * bytes_per_value
+
+
+def cache_comparison(layers: int, tokens: int, query_heads: int, kv_heads: int, head_dim: int, latent_dim: int, rope_dim: int, bytes_per_value: int = 2) -> dict[str, int]:
+    if kv_heads > query_heads:
+        raise ValueError("kv_heads cannot exceed query_heads")
+    mha = kv_cache_bytes(layers, tokens, query_heads, head_dim, bytes_per_value)
+    gqa = kv_cache_bytes(layers, tokens, kv_heads, head_dim, bytes_per_value)
+    mla = layers * tokens * (latent_dim + rope_dim) * bytes_per_value
+    return {"mha": mha, "gqa": gqa, "simplified_mla": mla}
+
+
+def low_rank_adapter(in_features: int, out_features: int, rank: int, seed: int = 42) -> tuple[np.ndarray, np.ndarray]:
+    if not 0 < rank <= min(in_features, out_features):
+        raise ValueError("rank must be positive and no larger than either feature dimension")
+    rng = np.random.default_rng(seed)
+    a = rng.normal(0, 0.02, size=(rank, in_features))
+    b = np.zeros((out_features, rank))
+    return a, b
+
+
+def adapter_parameter_count(in_features: int, out_features: int, rank: int) -> dict[str, int | float]:
+    dense = in_features * out_features
+    adapter = rank * (in_features + out_features)
+    return {"dense": dense, "adapter": adapter, "fraction": adapter / dense}
+
+
+@dataclass(frozen=True)
+class Quantized4Bit:
+    values: np.ndarray
+    scale: float
+
+    def dequantize(self) -> np.ndarray:
+        return self.values.astype(np.float64) * self.scale
+
+
+def symmetric_quantize_4bit(values: np.ndarray) -> Quantized4Bit:
+    values = np.asarray(values, dtype=np.float64)
+    peak = float(np.max(np.abs(values))) if values.size else 0.0
+    scale = peak / 7.0 if peak else 1.0
+    quantized = np.clip(np.rint(values / scale), -7, 7).astype(np.int8)
+    return Quantized4Bit(quantized, scale)
+
+
+def grpo_advantages(rewards: np.ndarray, epsilon: float = 1e-8) -> np.ndarray:
+    rewards = np.asarray(rewards, dtype=np.float64)
+    if rewards.ndim != 2 or rewards.shape[1] < 2:
+        raise ValueError("rewards must be [prompts, candidates] with at least two candidates")
+    mean = rewards.mean(axis=1, keepdims=True)
+    std = rewards.std(axis=1, keepdims=True)
+    return (rewards - mean) / (std + epsilon)
+
+
+def moe_route(logits: np.ndarray, top_k: int, capacity_factor: float = 1.0) -> dict[str, object]:
+    logits = np.asarray(logits, dtype=np.float64)
+    if logits.ndim != 2 or not 0 < top_k <= logits.shape[1] or capacity_factor <= 0:
+        raise ValueError("invalid logits, top_k, or capacity_factor")
+    tokens, experts = logits.shape
+    routes = np.argsort(-logits, axis=1, kind="stable")[:, :top_k]
+    capacity = math.ceil(capacity_factor * tokens * top_k / experts)
+    loads = np.zeros(experts, dtype=int)
+    accepted = np.zeros_like(routes, dtype=bool)
+    for token in range(tokens):
+        for slot in range(top_k):
+            expert = routes[token, slot]
+            if loads[expert] < capacity:
+                loads[expert] += 1
+                accepted[token, slot] = True
+    assignments = tokens * top_k
+    dropped = assignments - int(accepted.sum())
+    return {"routes": routes, "accepted": accepted, "loads": loads, "capacity": capacity, "dropped": dropped, "imbalance": float(loads.max() / max(loads.mean(), 1.0))}
